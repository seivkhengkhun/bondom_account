# Secrets — never commit real tokens
.env

# Databases — production data must never live in git
*.db
*.db.*
*.sqlite
*.sqlite3
backups/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Local tool settings (machine-specific, may hold local paths/permissions)
.claude/

# Reflex build artifacts
app/web/.web/
app/web/.states/
assets/external/

# Runtime caches (animated Telegram emoji for the website)
.cache/
